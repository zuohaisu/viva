# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
build/
.next/
.turbo/

# Logs
*.log

# Local temp / scratch
tmp/
scratch/
*.bak
.qa-tmp/


# Retired Ticket Autopilot artifacts and Viva worktrees. The historical
# ~/.ticket-autopilot state directory is never read or written by Viva. The
# Python runtime was retired in V13; crates/viva lives outside these rules.
.ticket-autopilot/
/runs/
/worktrees/

# Secrets / credentials (never commit)
.env
.env.*
!.env.example
!.env.*.example
*.local

# Engine sandbox (strict cwd for the cli executor) — keep .gitkeep
sandbox/*
!sandbox/.gitkeep
# Agent tool caches / scratch
.firecrawl/
.workbuddy/
.zcode/
.qoder/settings.local.json

# Rust build artifacts (workspace target dir)
/target
